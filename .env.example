# URL interna del Gateway, usada solo por el servidor Next.js.
GATEWAY_INTERNAL_URL=http://localhost:3000

# Origen público del Hub, usado solo por el servidor para redirecciones seguras.
HUB_PUBLIC_ORIGIN=http://localhost:3001

# Clave fija registrada en WEB_CLIENT_CATALOG.
AUTH_TOOL_KEY=beneficiary

# Puerto público del servicio biométrico consumido por el navegador.
NEXT_PUBLIC_BIOMETRIC_PORT=8899

# Entorno visible por la interfaz: dev, test o prod.
NEXT_PUBLIC_DEPLOY_ENV=dev
